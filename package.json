{
  "name": "watch2gether-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Watch2Gether - Cross-Platform Media Synchronization Platform",
  "workspaces": [
    "packages/*",
    "backend",
    "web",
    "e2e"
  ],
  "scripts": {
    "build:shared": "npm run build -w @watch2gether/shared",
    "build:backend": "npm run build:shared && npm run build -w @watch2gether/backend",
    "build:web": "npm run build:shared && npm run build -w @watch2gether/web",
    "build": "npm run build:web",
    "start:backend": "cd backend && npm start",
    "start": "cd backend && npm start",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "watch2gether",
    "sync",
    "realtime",
    "socket.io",
    "fastify",
    "nextjs",
    "android"
  ],
  "author": "Watch2Gether Team",
  "license": "MIT"
}
