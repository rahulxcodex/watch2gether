# Watch2Gether Backend Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git!

NODE_ENV=production
PORT=3001

# Database - from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis - from https://upstash.com (use the ioredis URL, not REST URL)
# Format: rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# JWT Secret (any long random string)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Frontend CORS origin
CORS_ORIGIN=https://your-app.vercel.app
